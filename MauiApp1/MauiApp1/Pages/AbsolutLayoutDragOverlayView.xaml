<?xml version="1.0" encoding="utf-8" ?> 
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:MauiApp1.Pages"
             x:Class="MauiApp1.Pages.AbsolutLayoutDragOverlayView"
             AbsoluteLayout.LayoutBounds="{Binding OverlayBounds}"
             AbsoluteLayout.LayoutFlags="None"
             MaximumWidthRequest="200" IsVisible="{Binding IsVisible}">
    <Frame>
        <VerticalStackLayout>
            <Label Text="To Be Copied..." HorizontalOptions="Center" FontSize="12" Margin="5" />
            <Label x:Name="DragOverlayLabel"
                    Text="{Binding DragText}"
                    BackgroundColor="LightYellow"
                    TextColor="Black"                    
                    FontSize="12"/>
        </VerticalStackLayout>
    </Frame>
</ContentView>
